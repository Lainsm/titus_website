# ---------------------------------------------------------------------------
# Copy to .env.local for development, or set these in the Infomaniak dashboard.
# ---------------------------------------------------------------------------

# MariaDB / MySQL connection string. On Infomaniak web hosting, take the host,
# database name and credentials from the Manager's Databases section.
DATABASE_URL=mysql://titus:titus@127.0.0.1:3306/titus
# Production (Infomaniak):
# DATABASE_URL=mysql://USER:PASSWORD@483sm8.myd.infomaniak.com:3306/483sm8_titus

# Infomaniak gives the database its own hostname (e.g. 483sm8.myd.infomaniak.com
# on port 3306) — it is a separate server, reached over their internal network,
# so DATABASE_URL points there rather than at localhost.
#
# Leave this at 0: that shared MySQL service does not offer TLS, and switching
# it on when the server does not support it fails the connection outright. Set
# it to 1 only if you move the database somewhere that does.
DB_SSL=0

# With DB_SSL=1 the server certificate is VERIFIED. If the provider's CA is not
# in the system trust store, paste the PEM here.
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n…"
#
# Last resort: skip verification entirely. This encrypts the connection but
# authenticates nothing, so anyone who can answer on the database host's
# address can read the credentials and every row. Only ever acceptable on a
# trusted local network.
# DB_SSL_INSECURE=1

# Public base URL — used for links in confirmation and newsletter e-mails, and
# to tell Next.js which Origin may invoke Server Actions. If this is wrong,
# every form on the site fails its CSRF check behind the reverse proxy.
# Must be the real https:// domain in production, no trailing slash.
SITE_URL=http://localhost:3000
# Production: SITE_URL=https://www.bihl.ch

# Next.js encrypts the variables a Server Action closes over. Without a fixed
# key it generates a fresh one per build, so anyone mid-submit across a deploy
# — and every instance in a multi-process setup — gets "Failed to find Server
# Action". Generate once and keep it: openssl rand -base64 32
# It must be present for BOTH `next build` and the running server.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# E-mail (Infomaniak SMTP)
# Create a mailbox in the Infomaniak manager, then use its address + password.
# ---------------------------------------------------------------------------
SMTP_HOST=mail.infomaniak.com
SMTP_PORT=587
SMTP_USER=noreply@example.ch
SMTP_PASSWORD=
# Envelope sender. Should match SMTP_USER's domain or Infomaniak will reject it.
MAIL_FROM="Titus Lainsbury <noreply@example.ch>"
# Where "Reply" goes when a reader answers the newsletter.
MAIL_REPLY_TO=

# Milliseconds to wait between newsletter messages, to stay inside
# Infomaniak's sending limits. 1200ms ~= 50 mails/minute.
MAIL_THROTTLE_MS=1200
