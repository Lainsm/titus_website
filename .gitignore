# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Secrets. `.env*` deliberately catches .env, .env.local and anything else that
# turns up — but NOT .env.example, which is the only record of which variables
# the deployment needs. Without the negation below it was silently excluded,
# and a fresh clone had nothing to copy from.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local tool settings: machine-specific, full of absolute paths from one
# person's laptop. A shared .claude/settings.json may still be committed.
.claude/settings.local.json

# A checkout of someone else's UX-skills collection that ended up here as a
# submodule with no .gitmodules — so a fresh clone got an empty directory and a
# failing `git submodule update`. The files are kept on disk, out of the repo.
/awesome-ux-skills/

# Generated by `npm run admin:sql`: contains a password hash, and is a
# throwaway you paste once into phpMyAdmin.
/db/admin-login.sql
